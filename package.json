{
  "name": "clone-agenda-facil",
  "version": "1.0.0",
  "description": "Plataforma AgendaFácil Full-Stack",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run db:wait && npm run migrations:up && next dev",
    "dev:setup": "npm run services:up && npm run db:wait && npm run migrations:up && npm run db:seed",
    "services:up": "docker compose --env-file .env.development -p agendafacil -f infra/compose.yaml up -d",
    "services:stop": "docker compose -p agendafacil -f infra/compose.yaml stop",
    "services:down": "docker compose --env-file .env.development -p agendafacil -f infra/compose.yaml down",
    "db:wait": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "DATABASE_URL=postgres://postgres:postgres@localhost:5433/agenda_facil_development node-pg-migrate -m infra/migrations up",
    "db:seed": "node infra/scripts/seed.js",
    "db:reset": "node infra/scripts/reset.js"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cookie": "^0.6.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^14.2.15",
    "node-pg-migrate": "^7.8.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prettier": "^3.4.2"
  }
}
