{
  "name": "clone-agenda-facil",
  "version": "1.0.0",
  "description": "AgendaFácil — plataforma de agendamentos entre clientes e prestadores de serviços. Programado por Matheus Barbosa.",
  "main": "index.js",
  "scripts": {
    "predev": "node infra/scripts/check-node.cjs",
    "dev": "npm run services:up && npm run services:wait && npm run migrations:up && next dev",
    "dev:seed": "node --env-file=.env.development infra/scripts/seed.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "start:production": "node infra/scripts/migrate.mjs up && next start",
    "vercel-build": "node infra/scripts/migrate.mjs up && next build --webpack",
    "services:up": "docker compose -p agendafacil -f infra/compose.yaml up -d",
    "services:stop": "docker compose -p agendafacil -f infra/compose.yaml stop",
    "services:down": "docker compose -p agendafacil -f infra/compose.yaml down",
    "services:wait": "node --env-file=.env.development infra/scripts/wait-for-postgres.mjs",
    "migrations:create": "node-pg-migrate -m infra/migrations -j js create",
    "migrations:up": "node --env-file=.env.development infra/scripts/migrate.mjs up",
    "migrations:down": "node --env-file=.env.development infra/scripts/migrate.mjs down",
    "maintenance": "node infra/scripts/maintenance.mjs",
    "secrets:generate": "node infra/scripts/generate-secrets.mjs",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "pretest": "node infra/scripts/check-node.cjs",
    "test": "npm run services:up && npm run services:wait && npm run migrations:up && jest --runInBand",
    "test:watch": "jest --watchAll --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheusBarbosaDeAndrade/clone-agenda-facil.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MatheusBarbosaDeAndrade/clone-agenda-facil/issues"
  },
  "homepage": "https://github.com/MatheusBarbosaDeAndrade/clone-agenda-facil#readme",
  "dependencies": {
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "prettier": "^3.9.10"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
