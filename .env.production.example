# =====================================================================
# AgendaFácil — variáveis de PRODUÇÃO
# Vercel: cadastre-as em Settings → Environment Variables (veja DEPLOY.md).
# VPS/Docker: copie para .env.production e preencha. NUNCA versione o arquivo real.
# Gere segredos com:  npm run secrets:generate
# =====================================================================

# --- Domínio -----------------------------------------------------------
DOMAIN=seudominio.com.br
APP_URL=https://seudominio.com.br
ACME_EMAIL=seu-email@seudominio.com.br

# --- Banco de dados ----------------------------------------------------
# Com infra/compose.production.yaml o host é definido automaticamente.
# Em banco gerenciado (Neon, Supabase, RDS...) use DATABASE_URL com SSL.
POSTGRES_USER=agendafacil
POSTGRES_DB=agendafacil
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# POSTGRES_SSL=require

# --- Criptografia dos dados pessoais (OBRIGATÓRIA) ----------------------
# 32 bytes em base64. Guarde uma cópia segura: sem ela, telefones e
# mensagens não podem ser recuperados.
DATA_ENCRYPTION_KEY=

# --- Vercel Cron (rotina de retenção de dados) ---------------------------
CRON_SECRET=

# --- E-mail (recuperação de senha) --------------------------------------
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="AgendaFácil <nao-responda@seudominio.com.br>"

# --- Login com Google (opcional) ----------------------------------------
# URI de redirecionamento autorizada no Google Cloud Console:
#   https://seudominio.com.br/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LGPD: dados do controlador exibidos na Política de Privacidade ----
LEGAL_NAME=AgendaFácil
LEGAL_DOCUMENT=
LEGAL_ADDRESS=
PRIVACY_CONTACT_EMAIL=privacidade@seudominio.com.br
DPO_NAME=
